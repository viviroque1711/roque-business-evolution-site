---
// Página servida com status 404 real para qualquer endereço inexistente (GitHub Pages usa este arquivo).
import '@fontsource/unbounded/latin-500.css';
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-700.css';
import '../styles/site.css';
import '../styles/extra.css';
import { SITE } from '../data/site.mjs';
import { SERVICES } from '../data/nav.mjs';
---
<!doctype html>
<html lang={SITE.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Página não encontrada | Roque Business Evolution</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
</head>
<body class="nf">
<main class="nf-in" id="conteudo">
  <h1>Esta página não existe</h1>
  <p>O endereço que você abriu não foi encontrado. Volte para a página inicial ou escolha um caminho abaixo.</p>
  <p><a class="btn" href="/">Ir para a página inicial</a></p>
  <ul class="nf-links">
    {SERVICES.slice(0, 8).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
  </ul>
</main>
</body>
</html>
