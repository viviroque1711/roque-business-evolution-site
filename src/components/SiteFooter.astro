---
import { SERVICE_GROUPS, AI_APPS, PRODUCTS, PARA_QUEM, EMPRESA, LEGAL, WHATSAPP } from '../data/nav.mjs';
import { SITE } from '../data/site.mjs';
import { u } from '../lib/url.mjs';
const { updated } = Astro.props;
const fmt = updated ? updated.split('-').reverse().join('/') : '';
---
<footer class="ft">
  <div class="ft-in">
    <div class="ft-id">
      <img class="ft-logo" src={u('/img/roque-logo-fundo-escuro.png')} width="248" height="289" alt="Roque Business Evolution" loading="lazy" decoding="async">
      <p class="ft-line">Estratégia para evoluir. Tecnologia para transformar. Inteligência para crescer.</p>
      <p class="ft-legal">{SITE.legalName}<br>CNPJ {SITE.cnpj}</p>
      <ul class="ft-social">
        <li><a href={WHATSAPP.href} rel="noopener">WhatsApp {WHATSAPP.label}</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.instagram} rel="noopener me">Instagram</a></li>
      </ul>
    </div>
    {SERVICE_GROUPS.map((g) => (
      <nav class="ft-col" aria-label={g.name}>
        <p class="ft-h">{g.name}</p>
        <ul>{g.items.map((s) => <li><a href={u(s.href)}>{s.label}</a></li>)}</ul>
      </nav>
    ))}
    <nav class="ft-col" aria-label="Aplicações, produtos e para quem">
      <p class="ft-h">Agentes de IA e plataformas</p>
      <ul>{AI_APPS.map((s) => <li><a href={u(s.href)}>{s.label}</a></li>)}</ul>
      <p class="ft-h">Produtos</p>
      <ul>{PRODUCTS.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}<li><a href={u('/produtos/')}>Sobre os produtos</a></li></ul>
      <p class="ft-h">Para quem</p>
      <ul>{PARA_QUEM.map((s) => <li><a href={u(s.href)}>{s.label}</a></li>)}</ul>
    </nav>
    <nav class="ft-col" aria-label="Empresa e fundadora">
      <p class="ft-h">Empresa</p>
      <ul>{EMPRESA.map((s) => <li><a href={u(s.href)}>{s.label}</a></li>)}<li><a href={u('/blog/')}>Blog</a></li>{LEGAL.map((s) => <li><a href={u(s.href)}>{s.label}</a></li>)}</ul>
      <p class="ft-h">Fundadora</p>
      <ul>
        <li><a href={SITE.founder.site} rel="noopener">Viviane Roque</a></li>
        <li><a href={SITE.founder.linkedin} rel="noopener">LinkedIn da Viviane</a></li>
        <li><a href={SITE.founder.instagram} rel="noopener">Instagram da Viviane</a></li>
      </ul>
    </nav>
  </div>
  <p class="ft-copy">© 2026 Roque Business Evolution. Todos os direitos reservados.{fmt && <> Atualizado em {fmt}.</>}</p>
</footer>
